# =============================================================================
# Twenty CRM — Configuración de Campañas de LinkedIn & Sales Navigator
# =============================================================================

# Modo de navegador: False para visual (depuración/login), True para segundo plano
HEADLESS=false

# Delays entre leads (en segundos) para evitar bloqueos
DEFAULT_DELAY_MIN=90
DEFAULT_DELAY_MAX=180

# Límite de leads por ejecución por defecto
DEFAULT_BATCH_LIMIT=20

# Ruta de perfil de Chrome persistente (se almacena tu sesión de LinkedIn)
CHROME_PROFILE_DIR=./.chrome-session

# Datos de la base de datos de Twenty CRM
