# =============================================================================
# Twenty CRM — Configuración de Campañas de Email en Frío
# =============================================================================
# Copia este archivo a .env.campaign y añade tu Contraseña de Aplicación de Google.
#
# Para generar una Contraseña de Aplicación:
# 1. Ve a https://myaccount.google.com/apppasswords
# 2. Inicia sesión con raul.almeida@arsoluciondigital.com (requiere 2FA)
# 3. Crea una app llamada "Twenty CRM" y pega los 16 caracteres en SMTP_PASS.
# =============================================================================

# Configuración SMTP de Google Workspace
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=raul.almeida@arsoluciondigital.com
SMTP_PASS=tu_app_password_de_16_caracteres

# Remitente
FROM_NAME=Raul Almeida
FROM_EMAIL=raul.almeida@arsoluciondigital.com
REPLY_TO=raul.almeida@arsoluciondigital.com

# Delays entre envíos (en segundos) para evitar bloqueos
DEFAULT_DELAY_MIN=45
DEFAULT_DELAY_MAX=90

# Límite de envíos por defecto por ejecución
DEFAULT_BATCH_LIMIT=30

# Schema de Twenty CRM en Postgres
WORKSPACE_SCHEMA=workspace_dy5bo7ispsr4124id7w3seocg
WORKSPACE_MEMBER_ID=2801663c-0ab4-4a61-8a2a-88dd2e709c07
