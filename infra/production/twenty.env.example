# Copy to a local .env or provision as /opt/twenty-crm/.env on the server.
# Never commit the populated file.
IMAGE_REFERENCE=ghcr.io/arsoluciondigital/crm:local
SERVER_URL=http://localhost:3001
TWENTY_PORT=3001
PG_DATABASE_NAME=default
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=change-me
APP_SECRET=change-me-to-a-long-random-value
STORAGE_TYPE=local
REDIS_URL=redis://redis:6379
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
